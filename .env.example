# ---------- Core ----------
PORT=3000
NODE_ENV=production
# Public URL of the site (used in emails, Stripe redirects, sitemap). No trailing slash.
BASE_URL=https://www.your-domain.com
# Where the SQLite database and uploaded files live. MUST be a persistent disk/volume in production.
DATA_DIR=./data

# ---------- First admin account (created on first boot if no admin exists) ----------
# If ADMIN_PASSWORD is empty a random one is generated and printed ONCE in the server log.
ADMIN_EMAIL=owner@your-domain.com
ADMIN_PASSWORD=

# ---------- Stripe (payments) ----------
# Without STRIPE_SECRET_KEY, online payments are disabled in production
# (in development a clearly-labelled DEMO payment screen is used instead).
STRIPE_SECRET_KEY=sk_live_or_test_xxx
# Stripe Dashboard → Developers → Webhooks → endpoint: BASE_URL/api/webhooks/stripe
# events: checkout.session.completed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Email (Resend: https://resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM="Toro Pinto Cleaning <hello@your-domain.com>"

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---------- Google ----------
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_MAPS_API_KEY=

# Allow fake "demo" payments even in production when Stripe is not configured (NOT recommended).
ALLOW_DEMO_PAYMENTS=0
